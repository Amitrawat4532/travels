# ── Required ────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker compose up -d gives you this one)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pahadiseat?schema=public"

# Public base URL — used for SEO metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared secret for the reminder cron endpoint (/api/cron/reminders)
CRON_SECRET="change-me-to-a-long-random-string"

# ── Optional ────────────────────────────────────────────────────────────
# Where uploaded documents and photos are stored (local disk adapter)
# STORAGE_DIR="./storage"

# Demo accounts (development only). Seed refuses demo accounts in production
# unless SEED_DEMO_ACCOUNTS=true; the login page shows them only outside production.
# DEMO_PASSWORD="Pahadi@2026"
# SEED_DEMO_ACCOUNTS="false"
# SHOW_DEMO_ACCOUNTS="false"

# Payments — default is "pay_to_driver" (seat reserved, pay at boarding).
# PAYMENT_PROVIDER="razorpay"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Vehicle studio images (imagin.studio licensed customer key). Without it,
# drivers see an illustrated preview of their vehicle type and colour.
# NEXT_PUBLIC_IMAGIN_CUSTOMER_KEY=""

# External notification channels (stubs log to console until a provider is wired)
# NOTIFY_SMS_ENABLED="false"
# NOTIFY_WHATSAPP_ENABLED="false"
# NOTIFY_EMAIL_ENABLED="false"
